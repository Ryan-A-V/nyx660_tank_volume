[Unit]
Description=Helios2 Wide Tank Volume Measurement Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ryan
Group=ryan
WorkingDirectory=/home/ryan/opt/nyx660_tank_volume/nyx660_tank_volume
ExecStart=/home/ryan/opt/nyx660_tank_volume/.venv/bin/nyx660-server --config /home/ryan/opt/nyx660_tank_volume/nyx660_tank_volume/config.yaml

# Restart on failure with a brief delay
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ryan/opt/nyx660_tank_volume/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=helios2-tank-volume

# Resource limits
# The Arena SDK needs access to network interfaces for GigE Vision
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ryan/opt/nyx660_tank_volume/data

[Install]
WantedBy=multi-user.target
